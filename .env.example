# ============================================================================
# Telegram
# ============================================================================
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma separated Telegram user IDs allowed to use the bot (get yours from @userinfobot)
ALLOWED_USER_IDS=
# Optional: separate admin IDs for health alerts (defaults to ALLOWED_USER_IDS)
ADMIN_IDS=

# ============================================================================
# Storage
# ============================================================================
# SQLite by default (WAL mode is enabled automatically)
DATABASE_URL=sqlite+aiosqlite:///./data/kwork.db
# PostgreSQL example (install the "postgres" extra: pip install asyncpg)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/kwork

# ============================================================================
# Optional LLM analysis (any OpenAI-compatible API: OpenAI, OpenRouter, Groq, Ollama)
# ============================================================================
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=45

# ============================================================================
# Networking
# ============================================================================
# Global proxy applied to every source without its own proxy_url (optional)
HTTP_PROXY=
# Per-source tokens (referenced from config/sources.yaml via token_env)
FREELANCEHUNT_TOKEN=

# ============================================================================
# Misc
# ============================================================================
LOG_LEVEL=INFO
CONFIG_DIR=config
TIMEZONE=Europe/Moscow
